# Leave DATABASE_URL empty for local embedded PostgreSQL.
DATABASE_URL=
# Required for hosted deployments. Share this password privately with reviewers.
REVIEW_PASSWORD=
# Set to true to enable the OpenAI-compatible LLM adjudicator (default: false).
LLM_ENABLED=
# OpenAI-compatible API endpoint (e.g. https://api.openai.com/v1). Required when LLM_ENABLED=true.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
