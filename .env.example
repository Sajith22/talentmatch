# Leave DATABASE_URL empty for local embedded PostgreSQL.
DATABASE_URL=
# Required for hosted deployments. Share this password privately with reviewers.
REVIEW_PASSWORD=
# Set to true to enable optional LLM judgments (default: false).
LLM_ENABLED=false
# API base, without /chat/completions (Groq: https://api.groq.com/openai/v1).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
